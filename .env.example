NEXT_PUBLIC_API_URL=https://shrayutechbackend.onrender.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key-here

# Backend the Next.js dev proxy forwards /api/* to (defaults to http://localhost:5000 in dev)
BACKEND_URL=http://localhost:5000

# HTTP Basic auth for the /admin console (server-only; never prefix with NEXT_PUBLIC_).
# If unset, /admin is open in development and returns 404 in production.
ADMIN_CONSOLE_USER=
ADMIN_CONSOLE_PASSWORD=
